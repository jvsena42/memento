# Twitter API credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
BOT_USER_ID=

# Bot settings
BOT_HANDLE=MementoBot
DATABASE_PATH=./memento.db
DEV_MODE=true
POLL_INTERVAL=30s
REPUBLISH_DELAY=5m   # Base delay per year in DEV_MODE (e.g. 5m × 2 years = 10m). Ignored in production (always real years).
MAX_CAPSULES_PER_DAY=100
MAX_MENTION_PAGES=3
MAX_CAPSULES_PER_USER_PER_DAY=5